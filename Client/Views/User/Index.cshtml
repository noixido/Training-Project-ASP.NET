@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/MainLayout.cshtml";
}

@section HeaderScript {
    <script src="~/adminlte-3.2.0/plugins/jquery/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jwt-decode@3/build/jwt-decode.min.js"></script>
    <script>
        var isLoggedIn = localStorage.getItem('jwtToken');
        if (!isLoggedIn) {
            var currentUrl = window.location.href;
            localStorage.setItem('redirectUrl', currentUrl);
            window.location.href = '/login';
        }
    </script>
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="form-group col">
                                <label for="nik">Nomor Induk Karyawan</label>
                                <p id="nik"></p>
                            </div>
                            <div class="form-group col">
                                <label for="fullName">Nama Lengkap</label>
                                <p id="fullName"></p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col">
                                <label for="phone">Nomor Nomor Telepon</label>
                                <p id="phone"></p>
                            </div>
                            <div class="form-group col">
                                <label for="birthDate">Tanggal Lahir</label>
                                <p id="birthDate"></p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col">
                                <label for="email">Email</label>
                                <p id="email"></p>
                            </div>
                            <div class="form-group col">
                                <label for="degree">Jenjang Pendidikan</label>
                                <p id="degree"></p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col">
                                <label for="gpa">Indeks Prestasi Kumulatif</label>
                                <p id="gpa"></p>
                            </div>
                            <div class="form-group col">
                                <label for="univName">Asal Kampus</label>
                                <p id="univName"></p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="form-group col">
                                <label for="roleName">Jabatan</label>
                                <p id="roleName"></p>
                            </div>
                        </div>
                        
                        <div class="d-flex" style="gap:5px;">
                            <button id="modalButton" type="button" class="btn btn-warning" data-toggle="modal" data-target="#modal-default" data-tooltip="tooltip" data-placement="right" title="Edit Profile">
                                <i class="fas fa-pencil-alt"></i>&nbsp; Edit Profile
                            </button>
                            <button id="modalChangePassButton" type="button" class="btn btn-warning" data-toggle="modal" data-target="#modalChangePass" data-tooltip="tooltip" data-placement="right" title="Change Password">
                                <i class="fas fa-key"></i>&nbsp; Change Password
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="modal-default">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Edit Employee Data Modal</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="empForm">
                    <div class="card-body">
                        <div class="form-group">
                            <label for="firstName">First Name</label>
                            <input type="text" name="firstNameForm" class="form-control" id="firstNameForm" placeholder="Enter Your First Name" required>
                        </div>
                        <div class="form-group">
                            <label for="lastName">Last Name</label>
                            <input type="text" name="lastNameForm" class="form-control" id="lastNameForm" placeholder="Enter Your Last Name">
                        </div>
                        <div class="form-group">
                            <label for="phone">Phone Number</label>
                            <input type="text" name="phoneForm" class="form-control" id="phoneForm" placeholder="Enter Your Phone Number">
                        </div>
                        <div class="form-group">
                            <label for="birthDate">Birth Date</label>
                            <input type="date" name="birthDateForm" class="form-control" id="birthDateForm" placeholder="Enter Your Birth Date">
                        </div>
                        <div class="form-group">
                            <label for="email">email</label>
                            <input type="email" name="emailForm" class="form-control" id="emailForm" placeholder="Enter Your Email">
                        </div>
                        <div class="form-group">
                            <label for="Degree">Degree</label>
                            <select class="form-control select2bs4" style="width: 100%;" id="degreeForm" name="degreeForm">
                                <option value="" selected disabled>== Select Degree ==</option>
                                <option value="D3">D3</option>
                                <option value="D4">D4</option>
                                <option value="S1">S1</option>
                                <option value="S2">S2</option>
                                <option value="S3">S3</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="gpa">GPA</label>
                            <input type="number" name="gpaForm" class="form-control" id="gpaForm" placeholder="Enter Your GPA" min="0" max="4">
                        </div>
                        <div class="form-group">
                            <label for="univ">University</label>
                            <select class="form-control select2bs4" style="width: 100%;" id="universityForm" name="universityForm"></select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                <div>
                    <button onclick="updateProfile()" id="editProfile" type="submit" form="empForm" class="btn btn-warning">Simpan Pembaruan</button>
                </div>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<div class="modal fade" id="modalChangePass">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Change Password</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="changePassForm">
                    <div class="card-body">
                        <div class="form-group">
                            <label for="oldPass">Old Password</label>
                            <input type="password" name="oldPass" class="form-control" id="oldPass" placeholder="Enter Your Old Password" required>
                        </div>
                        <div class="form-group">
                            <label for="newPass">New Password</label>
                            <input type="password" name="newPass" class="form-control" id="newPass" placeholder="Enter Your New Password">
                        </div>
                        <div class="form-group">
                            <label for="retypeNewPass">Re-type New Password</label>
                            <input type="password" name="retypeNewPass" class="form-control" id="retypeNewPass" placeholder="Re-type Your New Password">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                <div>
                    <button id="changePassButton" onclick="ChangeThePassword()" type="button" form="changePassForm" class="btn btn-warning">Simpan Pembaruan</button>
                </div>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

@section Script {
    <script src="~/script/userscript.js"></script>
    <script src="~/Script/LoginScript.js"></script>
}