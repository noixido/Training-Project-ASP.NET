
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/MainLayout.cshtml";
}
@section HeaderScript {
    <script src="~/adminlte-3.2.0/plugins/jquery/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jwt-decode@3/build/jwt-decode.min.js"></script>

    <script>
        var isLoggedIn = localStorage.getItem('jwtToken');
            if (!isLoggedIn) {
                var currentUrl = window.location.href;
                localStorage.setItem('redirectUrl', currentUrl);
                    window.location.href = '/login';
            }
    </script>
}
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Role DataTable</h3>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <button style="margin-bottom: 20px;" id="modalButton" type="button" class="btn btn-primary" data-toggle="modal" data-target="#modal-default" data-tooltip="tooltip" data-placement="top" title="Add Data">
                            <i class="fas fa-plus"></i>
                        </button>

                        <div class="modal fade" id="modal-default">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h4 class="modal-title">Role Modal</h4>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <form id="roleForm" name="roleForm" class="needs-validation" novalidate>
                                            <div class="card-body">
                                                <div class="form-group">
                                                    <label for="roleName">Role Name</label>
                                                    <input type="text" id="roleName" name="roleName" class="form-control" placeholder="Enter Role Name" required>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="modal-footer justify-content-between">
                                        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                        <div>
                                            <button id="modalEdit" type="button" class="btn btn-warning">Edit</button>
                                            <button id="modalAdd" type="submit" form="roleForm" class="btn btn-primary" onclick="addRole()">Simpan</button>
                                        </div>
                                    </div>
                                </div>
                                <!-- /.modal-content -->
                            </div>
                            <!-- /.modal-dialog -->
                        </div>

                        <table id="roleTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>No</th>
                                    <th>Role ID</th>
                                    <th>Role Name</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</section>

@section Script {
    <script src="~/Script/RoleScript.js"></script>
    <script src="~/Script/LoginScript.js"></script>
}